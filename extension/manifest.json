{
  "manifest_version": 3,
  "name": "ScamShield AI",
  "version": "1.0",
  "description": "Real-time AI-powered scam and phishing detection for URLs and text.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://YOUR_BACKEND_URL/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze with ScamShield AI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
